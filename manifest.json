{
  "manifest_version": 3,
  "name": "Tab Organiser",
  "description": "Group your open tabs into named, colour-coded groups with optional comments.",
  "version": "1.0.0",
  "permissions": [
    "tabs",
    "tabGroups",
    "storage",
    "bookmarks"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "background": {
    "service_worker": "background.js"
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
